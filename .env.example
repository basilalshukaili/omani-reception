# ============================================================
# Omani Reception — environment template
# ============================================================
# Copy this file to .env and fill in the real values.
# .env is gitignored — never commit secrets.

# ---------- Application ----------
RECEPTION_ENV=dev                       # dev | staging | prod
RECEPTION_BUSINESS_ID=generic_demo      # which business config to load
RECEPTION_LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=                     # @BotFather token
TELEGRAM_ADMIN_CHAT_ID=880315854        # Basil — privileged /teach command access
TELEGRAM_ESCALATION_CHAT_ID=            # where escalate_to_human notifies

# ---------- LLM (Gemini default for v1) ----------
LLM_PROVIDER=gemini                     # gemini | claude | openai
GEMINI_API_KEY=                         # from aistudio.google.com
GEMINI_MODEL_FAST=gemini-2.5-flash      # cheap, for normal turns
GEMINI_MODEL_QUALITY=gemini-2.5-pro     # for evaluation and judge calls

# Optional — not required for v1 (adapters present but not exercised live)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------- Embeddings (free in Gemini tier) ----------
EMBEDDING_PROVIDER=gemini               # gemini | openai | cohere
EMBEDDING_MODEL=text-embedding-004

# ---------- Postgres + pgvector ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=reception
POSTGRES_USER=reception
POSTGRES_PASSWORD=change-me-in-real-env

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ---------- Observability ----------
OTEL_EXPORTER=none                      # none | otlp | langfuse
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---------- Cost guardrails ----------
COST_USD_HARD_CAP=5.00                  # build budget — refuse paid calls beyond this
COST_USD_WARN_THRESHOLD=3.00            # log warning at this cumulative spend
